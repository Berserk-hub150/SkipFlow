{
  "manifest_version": 3,
  "name": "SkipFlow — Controlla ogni secondo",
  "short_name": "SkipFlow",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Avanti e indietro nei video, velocità personalizzata, loop A–B e segnalibri. Un piccolo telecomando per i tuoi video.",
  "permissions": ["storage", "activeTab"],
  "background": {"service_worker": "worker.js"},
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {
    "default_title": "SkipFlow · Telecomando video",
    "default_popup": "ui/popup.html",
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}
  },
  "options_ui": {"page": "ui/options.html", "open_in_tab": true},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*", "file:///*"],
    "all_frames": true,
    "match_about_blank": true,
    "match_origin_as_fallback": true,
    "run_at": "document_idle",
    "js": ["shared/core.js", "shared/overlay-style.js", "content.js"]
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
